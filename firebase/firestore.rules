rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Primary: use Firebase custom claims set by the server on every
    // claimOrJoinCompany call — no nested Firestore read needed.
    // Fallback: nested get() on users/{uid} for tokens minted before claims
    // were introduced (covers users who haven't called claimOrJoinCompany yet).
    function companyMatch(companyId) {
      return request.auth.token.companyId == companyId
          || myUser().companyId == companyId;
    }

    function isAdmin() {
      return request.auth.token.role == 'admin'
          || myUser().role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (isAdmin() && resource.data.companyId == request.auth.token.companyId)
      );
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']);
      allow create, delete: if false;
    }

    match /invites/{email} {
      allow read: if signedIn() && isAdmin()
          && resource.data.companyId == request.auth.token.companyId;
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if signedIn() && companyMatch(companyId);
      allow write: if false;

      match /alerts/{alertId} {
        allow read: if signedIn() && companyMatch(companyId);
        allow update: if signedIn() && companyMatch(companyId) && isAdmin();
        allow create, delete: if false;
      }

      match /subscription/{document=**} {
        allow read: if signedIn() && companyMatch(companyId);
        allow write: if false;
      }
    }
  }
}
